# CoWorkerIA - Plantilla de variables de entorno
# Copia este archivo a ".env" y rellena con tus valores reales.
# NUNCA subas el archivo .env al repositorio.

# --- OpenRouter cubre LLM + embeddings con una sola key ---
# Obtenla en https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Modelo LLM (para redactar respuestas con citas)
LLM_MODEL=anthropic/claude-sonnet-4
# Modelo de embeddings (para vectorizar texto)
EMBED_MODEL=openai/text-embedding-3-small
# Dimension del modelo (text-embedding-3-small = 1536)
EMBED_DIM=1536

# --- Base vectorial local (Chroma) ---
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=coworkeria
CHROMA_COLLECTION_ID=

# --- n8n ---
N8N_URL=http://localhost:5678
# API key para versionar workflows (Settings -> n8n API -> Create Key)
N8N_API_KEY=eyJ...
